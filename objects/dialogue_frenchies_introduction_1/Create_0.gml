event_inherited();
obj_scribble.textbox_unnamed(
	"You ask what he means by \"scary\".", 
);

obj_scribble.textbox(
	@"Well, even though I've taken classes with all of them,
	[/page]I've only talked to one of the guys, his name's [c_red]McRonald[/c]...
	", 
	"Frenchie", spr_frenchie_portrait_twiddling_thumbs
);
obj_scribble.textbox_unnamed(
	"There's no way that's a real name, right?", 
);
obj_scribble.textbox(
	@"On top of that, this is my first year living in a dormitory!
	[/page]Me mum was tired of my wee little self, cowering in the comfort of me home.
	[/page]She wanted me to make new friends. So here I am.
	[/page]Sleeping tonight, amongst these familiar faces who might as well be strangers.
	[/page]I-isn't that scary?
	", 
	"Frenchie", spr_frenchie_portrait_twiddling_thumbs
);
obj_scribble.textbox_unnamed(
	"...", 
);

obj_scribble.textbox(
	@"Um-
	[/page]Right, so sorry for holding you up!
	[/page]You're moving in, right?
	[/page]I'll get out of your way now!
	", 
	"Frenchie", spr_frenchie_portrait_nervous
);
