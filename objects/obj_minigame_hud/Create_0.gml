text_switch_timer = room_speed/3;
knife_timer = room_speed * 3;
question_zero_x = 30;
question_zero_y = 385;
question_x_margin = 400;
question_y_margin = 90;
question_width = 600;
question_line_sep = 40;
text_option = 0;
text_margin_of_error = 20;
