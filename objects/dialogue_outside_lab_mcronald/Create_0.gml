event_inherited();
obj_scribble.textbox(
	@"*startled by your presence
	[/page][vl_mcronald_default_1]Oh, hey, Bobby! How's it going?
	"
	,
	"McRonald", spr_mcronald_portrait_default
);
obj_scribble.textbox_unnamed("You look at him suspiciously.")
obj_scribble.textbox(
	@"[vl_mcronald_default_1]Um, I'm doing great, myself.
	[/page][vl_mcronald_default_2]As a matter of fact, I just got a text from our good old friend, Frenchie!
	[/page][vl_mcronald_default_1]He says he's coming back to school tonight, isn't that a relief?
	"
	,
	"McRonald", spr_mcronald_portrait_default
);
obj_scribble.textbox_unnamed("You ask him why he's using first person pronouns all of a sudden.")

obj_scribble.textbox(
	@"[vl_mcronald_default_1]McRonald doesn't understand what you mean by that!
	[/page][vl_mcronald_default_2]Um, anyways, good luck in the election! 
	"
	,
	"McRonald", spr_mcronald_portrait_default
);