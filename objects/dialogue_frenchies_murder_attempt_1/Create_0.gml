scr_text("and the sun is shining off the snow, bringin' the promise of spring to come, with flowers... ", spr_frenchie_down_stare, 0);
scr_text("and fresh grass, and more kittens, and hot summer days an' the gentle kiss of the rain...", spr_frenchie_down_stare, 0);
scr_text("Such wonderful things...", spr_frenchie_down_stare, 0);