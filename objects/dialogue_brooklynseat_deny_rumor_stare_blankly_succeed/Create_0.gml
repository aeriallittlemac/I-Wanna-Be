event_inherited();
scr_text("You sure have a keen eye, as far as dimwits go.", spr_brooklyn_portrait_default, 1);
scr_text("You're half right. My father does happen to be Jewish, actually.", spr_brooklyn_portrait_default, 1);
scr_text("He just happens to be one of the dumb orthodox ones living off of government welfare.", spr_brooklyn_portrait_default, 1);
scr_text("Utterly absurd that people still believe in the sky daddy to this day and age.", spr_brooklyn_portrait_default, 1);
scr_text("You shrug your shoulders.");
scr_text("Remembering that you had something to give her, you reach into your pocket.");
scr_text("You take out the letter and give it to her.");