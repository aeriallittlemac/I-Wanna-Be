event_inherited();

	
obj_scribble.textbox_converse(
@"Perhaps she ain't the most pleasant human being.
[/page]But isn't it strange that Grace's been missing...
[/page]Yet somehow, no one in this room seems to care?
[/page]Sis?
", "Wei", [
		[spr_wei_portrait_confusion, obj_portrait_mock_left_1], 
		[spr_mei_portrait_default, obj_portrait_mock_right_1]
	]
	);
obj_scribble.textbox_converse(
@"Ummmm, haha,
[/page]I-I guess that that's just kind of how Grace is, ya know...
[/page]Doing whatever she wants on a whim...
[/page]I bet that we're all thinking it's just another one of her stunts-
", "Mei", [
		[spr_wei_portrait_confusion, obj_portrait_mock_left_1], 
		[spr_mei_portrait_default, obj_portrait_mock_right_1]
	]
	);
obj_scribble.textbox_converse(
@"What's with the sudden change in attitude?
[/page]You were so much more worried about her yesterday.
", "Wei", [
		[spr_wei_portrait_confusion, obj_portrait_mock_left_1], 
		[spr_mei_portrait_default, obj_portrait_mock_right_1]
	]
	);
obj_scribble.textbox_converse(
@"Well, I thought about it more, and, y'know...
[/page]There's not much I can do, other than to leave it to the professionals, right?
[/page]So why worry about it-
", "Mei", [
		[spr_wei_portrait_confusion, obj_portrait_mock_left_1], 
		[spr_mei_portrait_uncomfortable_smile, obj_portrait_mock_right_1]
	]
	);
obj_scribble.textbox_converse(
@"The professionals? Gambino and his goons?
[/page]Really? Mei, have you stopped caring about your friend? How-
", "Wei", [
		[spr_wei_portrait_furious_1, obj_portrait_mock_left_1], 
		[spr_mei_portrait_uncomfortable_smile, obj_portrait_mock_right_1]
	]
	);
	
obj_scribble.textbox_converse(
@"Please, I just don't wanna talk about it, stop picking on me...
", "Mei", [
		[spr_wei_portrait_furious_1, obj_portrait_mock_left_1], 
		[spr_mei_portrait_uncomfortable, obj_portrait_mock_right_1]
	]
	);
obj_scribble.textbox(
@"...
", "Wei", spr_wei_portrait_confusion
)
