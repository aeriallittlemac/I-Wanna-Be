event_inherited();
obj_scribble.textbox(
@"Welcome, insetti.
[/page]Mr. Chen will resume his practice in a moment...
[/page]But first, there is an extremely important matter at hand.
", "Gambino", spr_gambino_portrait_default
)

obj_scribble.textbox(
@"You may have noticed the absence of an annoying pink banshee screaming in the room as of now.
[/page]That is right, we have a missing student.
[/page]Specifically, Grace has not made herself known since yesterday afternoon.
", "Gambino", spr_gambino_portrait_default
)
obj_scribble.textbox_unnamed(
@"Surprisingly, Gambino's news does not elicit much of a reaction.
"
);


obj_scribble.textbox(
@"Oh no, what shall we do without her delightful presence?
", "Mr. Chen", spr_mr_chen_portrait_default
)
obj_scribble.textbox(
@"...
", "Gambino", spr_gambino_portrait_default
)
obj_scribble.textbox(
@"Apologies, please continue sir.
", "Mr. Chen", spr_mr_chen_portrait_default
)

obj_scribble.textbox(
@"It is because of this concerning turn of events that I have decided...
[/page]To shut down any and all out of school competitions.
[/page]For this class specifically, this means the scheduled mathalon.
", "Gambino", spr_gambino_portrait_default
)

obj_scribble.textbox(
@"Nani?!
[/page]You can't do this!
[/page]In the name of the Moon, I'll-
", "Weeabo girl", spr_ashley_portrait_default
)
obj_scribble.textbox(
@"I will not risk the safety of the school's inhabitants with superfluous endeavors.
", "Gambino", spr_gambino_portrait_default
)
obj_scribble.textbox(
@"Superfluous?!
", "Weeabo girl", spr_ashley_portrait_default
)

obj_scribble.textbox(
@"Silenzio.
[/page]This is final. No questions will be taken.
[/page]Whilst we investigate the matter of Grace's disappearance, nobody leaves the premises.
[/page]I will know if you do.
", "Gambino", spr_gambino_portrait_default
)