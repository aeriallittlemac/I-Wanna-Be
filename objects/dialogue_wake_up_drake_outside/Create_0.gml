event_inherited();
obj_scribble.textbox(
	@"Robert, robert.
	[/page]Say, anything interesting caught your eye lately?
	[/page]Like the disappareance of a...certain blond fellow?
	",
	"Drake", spr_drake_portrait_default
);
obj_scribble.textbox_unnamed("[sfx_heartbeat]You ask what exactly he means")

obj_scribble.textbox(
	@"Ah, allow me to rephrase and start over. Y'know...
	[/page]Yesterday afternoon, I had a really bad case of alcohol poisoning, as one does.
	",
	"Drake", spr_drake_portrait_default
);

obj_scribble.textbox_unnamed("Where is this going?")

obj_scribble.textbox(
	@"Jake, my brother from another mother- 
	[/page]He, who would usually tend to my side with water and a plastic bag ready in hand-
	[/page][slant]was somehow nowhere to be found.[/slant]
	[/page]Preposterous, isn't it?
	",
	"Drake", spr_drake_portrait_default
);

obj_scribble.textbox_unnamed("You nod in agreement and confusion")

obj_scribble.textbox(
	@"Alas, the universe is works in mysterious ways.
	[/page]The harder you look for a man, the more the world seems determined to remind you of every place he isn't.
	[/page]Gambino needs to speak with him, I need his company, but Jake appears to have wandered beyond expectation.
	[/page]So tell me-
	[/page]where does a man go when everyone expects to find him?
	",
	"Drake", spr_drake_portrait_default
);
