event_inherited();
obj_scribble.textbox_unnamed(
	@"The smell of old cigars linger.
	[/page]There's not one to be found, and the door is still locked.
	[/page]Yet, a note with elegant handwriting is left behind.
	[/page]So it writes:
	"
);

obj_scribble.textbox_unnamed(
	@"[slant]Greetings, Bobby.
	[/page]I suppose you have discovered the applications of the ventiliation system.
	[/page]I do not know where you got that teddy bear from, but the fact that you left the room-
	[/page]-despite it being firmly locked, tells me everything I need to know.
	[/page]You have both proved your loyalty and resourcefulness by taking on this...
	[/page]very much unreasonable task. By law of reciprocation...
	[/page]I will do everything to make sure that nothings gets in the way of your acedemics.
	[/page]That is a promise I will make to you.
	[/page]Sincerely yours, Gambino.[/slant]
	"
);