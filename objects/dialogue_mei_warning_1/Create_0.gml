event_inherited();
obj_scribble.textbox_unnamed(
	@"This is the first time a girl has bothered to ask for your name.
[/page]It's so touching that you might just cry.
[/page]...you tell her your name.
"
);

obj_scribble.textbox(
	@"Bobby, gotcha.
[/page]You seem like a nice guy!
[/page]Whatcha doing?
", 
	"Mei", spr_mei_portrait_playful
);
obj_scribble.textbox_unnamed(
	@"You tell her that you're here to join the sewing club
"
);

obj_scribble.textbox(
	@"Um...
", 
	"Mei", spr_mei_portrait_uncomfortable
);

obj_scribble.textbox(
	@"Bobby, are you sure you don't want to try...
[/page]...other clubs?
", 
	"Mei", spr_mei_portrait_uncomfortable_smile
);
obj_scribble.textbox_unnamed(
	@"You insist that you're interested.
"
);
obj_scribble.textbox(
	@"Ya know, it's called a sewing club...
[/page]but we don't actually sew 'round here,
[/page]It's more or less just a space for girl gossip-
", 
	"Mei", spr_mei_portrait_uncomfortable_smile
);
obj_scribble.textbox_unnamed(
	@"You tell her that you have your reasons to be here.
[/page](To get bitches)
"
);

obj_scribble.textbox(
	@"I guess I can't stop you...
[/page]But just to give you a heads up.
[/page]Some of the girls might not take kindly to your, um,
[/page]existance. So, this might be a bad idea... 
", 
	"Mei", spr_mei_portrait_uncomfortable_smile
);
obj_scribble.textbox_unnamed(
	@"Undeterred by the big red flags, you walk in anyways.
"
);