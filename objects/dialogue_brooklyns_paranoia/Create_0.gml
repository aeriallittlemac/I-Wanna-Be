event_inherited();
set_QTE_bgm(somber_theme);
obj_scribble.textbox(
	@"I'm working with you on the math problems.
	[/page]Can't believe that it has to come to this...
	", 
	"Brooklyn", spr_brooklyn_portrait_default
);

obj_scribble.textbox(
	@"But I don't trust any of those f*ckers of there.
	[/page]I know they're gossiping about me, even if they're trying not to let me know.
	[/page]They're all snakes, each and every one of them-
	[/page]Even...
	", 
	"Brooklyn", spr_brooklyn_portrait_disgusted
);
obj_scribble.textbox_unnamed(
	@"She swallowed, as if trying to choke back her words.
	"
)
obj_scribble.textbox(
	@"...Even Gambino I think.
	[/page]He's been off as of late.
	[/page]I'm almost certain that he's cheating on me with someone else.
	", 
	"Brooklyn", spr_brooklyn_portrait_disgusted
);

obj_scribble.textbox_unnamed(
	@"These math questions sure are interesting-
	"
)
obj_scribble.textbox(
	@"Look at me, Bobby.
	[/page]Help me. I'm scared and I don't know what to do.
	[/page]But I need answers, and you're the only one I can turn to.
	[/page]Please?
	", 
	"Brooklyn", spr_brooklyn_portrait_disgusted
);
