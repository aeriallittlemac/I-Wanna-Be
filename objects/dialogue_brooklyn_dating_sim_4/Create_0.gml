event_inherited();
teleport_npc(obj_mcronald, school_sewing_club, obj_player.x-20, obj_player.y, DOWN);
obj_scribble.mcronald_y_offset = 160;
alarm[0] = 1;
obj_scribble.textbox(
	@"Gorgeous queens, McRonald makes his rounds for you!
	[/page]And... Bobby. Drag queen included, McRonald supposes.
	",
	"McRonald",spr_mcronald_portrait_default
	);
	
obj_scribble.textbox(
	@"Hi McRonald.
	",
	"Mei",spr_mei_portrait_default
	);
obj_scribble.textbox(
	@"B-b-b-baka???
	",
	"Weeabo Girl",spr_ashley_portrait_default
	);
obj_scribble.textbox(
	@"Look what McRonald has to show you gals today.
	",
	"McRonald",spr_mcronald_portrait_default
	);
obj_scribble.textbox_unnamed(
	@"McRonald pulls out his phone.
	[/page]There’s a crummy photoshop of him in front of a lambrogini.
	",
	);
obj_scribble.textbox(
	@"Just bought this sick new ride with all the money McRonald got from being rich. 
	[/page]It’s not too late to start falling for McRonald, girls - he’s the hottest property around!
	",
	"McRonald",spr_mcronald_portrait_default
	);
obj_scribble.textbox(
	@"Uh... That looks... uh.. cool?
	",
	"Mei",spr_mei_portrait_uncomfortable_smile
	);
obj_scribble.textbox(
	@"What is the matter, May?
	",
	"McRonald",spr_mcronald_portrait_default
	);
obj_scribble.textbox(
	@"That shitty AI generated photo of you in front of a car...
	[/page]What a [scale,1.2]shoddy forgery[/s], even from the [scale,1.2]likes[/s] of [scale,1.2]you[/s].
	",
	"Brooklyn",spr_brooklyn_portrait_amused
	);
obj_scribble.textbox(
	@"The photo is real, be most assured.
	",
	"McRonald",spr_mcronald_portrait_default
	);
obj_scribble.textbox(
	@"See that? Six fingers.
	[/page]Show me your sixth finger. Right now.
	",
	"Brooklyn",spr_brooklyn_portrait_disgusted
	);
obj_scribble.textbox(
	@"*Hides hand* McRonald does not want to.
	",
	"McRonald",spr_mcronald_portrait_fold_arms
	);
obj_scribble.textbox(
	@"Kill yourself.
	",
	"Brooklyn",spr_brooklyn_portrait_amused
	);
obj_scribble.textbox(
	@"Anything for you, Brooklyn finest.
	",
	"McRonald",spr_mcronald_portrait_flex
	);