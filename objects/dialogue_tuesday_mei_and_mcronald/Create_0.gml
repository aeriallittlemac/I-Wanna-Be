event_inherited();
obj_scribble.textbox(
	@"My queen. McRonald, requires a favor from your majesty.
	", 
	"McRonald", spr_brooklyn_portrait_default
);
obj_scribble.textbox(
	@"What is it, my humble subject?
	", 
	"Mei", spr_mei_portrait_default
);
obj_scribble.textbox(
	@"You associate with Brooklyn, yes?
	", 
	"McRonald", spr_brooklyn_portrait_default
);
obj_scribble.textbox(
	@"Of course, we’re besties!
	", 
	"Mei", spr_mei_portrait_default
);
obj_scribble.textbox(
	@"McRonald needs you to deliver a letter to Brooklyn.
	[/page]But you must promise not to read its content.
	", 
	"McRonald", spr_brooklyn_portrait_default
);

obj_scribble.textbox(
	@"Ooh! Trying to slide a love letter, are ya?
	", 
	"Mei", spr_mei_portrait_playful
);

obj_scribble.textbox(
	@"McRonald neither confirms nor denies that.
	", 
	"McRonald", spr_brooklyn_portrait_default
);

obj_scribble.textbox(
	@"?!
	", 
	"Mei", spr_mei_portrait_shocked
);

obj_scribble.textbox(
	@"Just promise McRonald not to read the letter, okay?
	", 
	"McRonald", spr_brooklyn_portrait_default
);