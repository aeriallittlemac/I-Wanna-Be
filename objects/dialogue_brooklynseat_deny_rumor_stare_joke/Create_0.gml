event_inherited();
scr_text("Yay, jail.", spr_bobby_icon, 1);
scr_text("You think I'd drop the soap on the first day?", spr_bobby_icon, 1);
scr_text("Ha! Cool as a cucumber, I see. I respect you for putting up a front.", spr_brooklyn_silhouette, 0);
scr_text("On a serious note, it would probably do well for you to identify as a girl and go to a female prison.", spr_brooklyn_silhouette, 0);
scr_text("I wouldn't say you're anywhere near attractive...", spr_brooklyn_silhouette, 0);
scr_text("But I wouldn't go as far as to say you're \"unrapeable\" either.", spr_brooklyn_silhouette, 0);
scr_text("Especially not in prison.", spr_brooklyn_silhouette, 0);
scr_text("That's probably the closest thing you'll get to a compliment from her.");