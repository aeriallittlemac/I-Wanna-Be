event_inherited();

obj_scribble.textbox(
	"He seemed so earnest... [delay,1000]Like he really liked [#faa2a2]Grace[/c]...",
	"Ashley", spr_ashley_portrait_default
);

obj_scribble.textbox(
	@"Why...? Why did [#faa2a2]she[/c] do that?
[/page][c_yellow]Brooklyn[/c], [#d86e5d]Mei[/c]... they don't care...
[/page]Why don't they care?",
	"Ashley", spr_ashley_portrait_default
);

obj_scribble.textbox(
	"[shake]He's dead...[/shake]",
	"Ashley", spr_ashley_portrait_default
);

obj_scribble.textbox_unnamed(
	"..."
);

obj_scribble.textbox(
	"[scale,0.75]I... [/page]I don't want to think about it anymore.[/s]",
